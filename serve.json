{
  "public": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/launch", "destination": "/launch.html" },
    { "source": "/home", "destination": "/home.html" },
    { "source": "/index", "destination": "/index.html" },
    { "source": "", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
